# Giveport environment variables
# Copy this file to .env.local and fill in the values.

# ── Clerk (authentication) ──────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs (optional — Clerk defaults work for most cases)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/setup

# ── Neon (database) ─────────────────────────────────────────────────────────
# Get this from https://console.neon.tech → Your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/giveport?sslmode=require

# ── Giveport settings ───────────────────────────────────────────────────────
# Override these on Vercel; the defaults in src/lib/config.ts are used otherwise.
# GIVEPORT_FEE_PERCENT=2
# GIVEPORT_CONTACT_EMAIL=hello@giveport.site
